# WindCtrl Validate - Environment Configuration

# Backend Configuration
WINDCTRL_ENV=development
WINDCTRL_DEBUG=true
WINDCTRL_HOST=0.0.0.0
WINDCTRL_PORT=8000
WINDCTRL_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Storage & Directory Paths
WINDCTRL_DATA_DIR=./data
WINDCTRL_REPORTS_DIR=./reports/generated
WINDCTRL_LOG_LEVEL=INFO

# Turbine Model Parameters (Default: NREL 5MW Baseline Turbine)
TURBINE_RATED_POWER_KW=5000.0
TURBINE_CUT_IN_SPEED_MPS=3.0
TURBINE_RATED_SPEED_MPS=11.4
TURBINE_CUT_OUT_SPEED_MPS=25.0
TURBINE_RATED_ROTOR_RPM=12.1
TURBINE_MAX_ROTOR_RPM=14.5
TURBINE_OVERSPEED_RPM=15.0
TURBINE_GEARBOX_RATIO=97.0
TURBINE_RATED_TORQUE_KNM=43.09

# Report Generation
WINDCTRL_LATEX_CMD=pdflatex
WINDCTRL_ENABLE_PDF_FALLBACK=true
